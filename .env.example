# Supabase Configuration
SUPABASE_URL="your_supabase_url_here"
SUPABASE_KEY="your_supabase_key_here"

# Optional: FastF1 Cache Directory (default: fastf1_cache)
# FASTF1_CACHE_DIR="my_custom_cache_dir"

# Optional: API Cache TTL in seconds (default: 3600)
# API_CACHE_TTL=7200

# Optional: Default Year for data (default: 2024)
# DEFAULT_YEAR=2023

# Optional: Token URL (default: /api/token)
# TOKEN_URL="/api/auth/token"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0