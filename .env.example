# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL="your_supabase_url_here"
SUPABASE_KEY="your_supabase_service_role_key_here"   # service-role key (not anon)

# ─── Auth0 ────────────────────────────────────────────────────────────────────
# 1. Go to https://auth0.com → Create Account → Create Tenant
# 2. Applications → Create Application → Single Page Application → "F1 Dashboard"
# 3. Settings: set Allowed Callback URLs, Logout URLs, Web Origins to http://localhost:8002
# 4. APIs → Create API → Name: "F1 Dashboard API" → Identifier: https://f1dashboard.api
AUTH0_DOMAIN="your-tenant.auth0.com"
AUTH0_CLIENT_ID="your_spa_client_id"
AUTH0_AUDIENCE="https://f1dashboard.api"

# ─── FastF1 ───────────────────────────────────────────────────────────────────
# FASTF1_CACHE_DIR="fastf1_cache"
# API_CACHE_TTL=3600
DEFAULT_YEAR=2026

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
